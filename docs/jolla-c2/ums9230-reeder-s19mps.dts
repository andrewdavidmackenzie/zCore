/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Reeder S19 Max Pro S";
	compatible = "reeder,s19mps", "sprd,ums9230";

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		nvmem@65014c00 {
			compatible = "sprd,ums9230-cache-efuse", "nvmem-rmem";
			reg = <0x00 0x65014c04 0x00 0x60>;
			no-map;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				cluster0-dvfs-bin@17 {
					reg = <0x17 0x01>;
					bits = <0x00 0x03>;
					phandle = <0x03>;
				};

				cluster1-dvfs-bin@1b {
					reg = <0x1b 0x01>;
					bits = <0x00 0x03>;
					phandle = <0x04>;
				};

				gpu-bin@1b {
					reg = <0x1b 0x01>;
					bits = <0x03 0x03>;
				};

				wcn-alpha@24 {
					reg = <0x24 0x04>;
					bits = <0x00 0x20>;
				};

				thm2-sen3@28 {
					reg = <0x28 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x67>;
				};

				thm2-sen2@29 {
					reg = <0x29 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x66>;
				};

				thm2-sen4@2b {
					reg = <0x2b 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x68>;
				};

				thm2-sen1@2e {
					reg = <0x2e 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x65>;
				};

				thm0-sen5@2f {
					reg = <0x2f 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x61>;
				};

				thm0-sign@38 {
					reg = <0x38 0x01>;
					bits = <0x00 0x01>;
					phandle = <0x5a>;
				};

				thm0-ratio@38 {
					reg = <0x38 0x01>;
					bits = <0x01 0x07>;
					phandle = <0x5b>;
				};

				thm0-sen0@39 {
					reg = <0x39 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x5c>;
				};

				thm2-sign@3e {
					reg = <0x3e 0x01>;
					bits = <0x00 0x01>;
					phandle = <0x62>;
				};

				thm2-ratio@3e {
					reg = <0x3e 0x01>;
					bits = <0x01 0x07>;
					phandle = <0x63>;
				};

				thm2-sen0@3f {
					reg = <0x3f 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x64>;
				};

				thm0-sen2@40 {
					reg = <0x40 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x5e>;
				};

				thm0-sen1@41 {
					reg = <0x41 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x5d>;
				};

				thm0-sen4@42 {
					reg = <0x42 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x60>;
				};

				thm0-sen3@43 {
					reg = <0x43 0x01>;
					bits = <0x00 0x08>;
					phandle = <0x5f>;
				};
			};
		};

		reserved@80000000 {
			reg = <0x00 0x80000000 0x00 0x2000>;
			no-map;
		};

		btwf@87000000 {
			reg = <0x00 0x87000000 0x00 0x240000>;
			no-map;
			phandle = <0x81>;
		};

		smem@87240000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x87240000 0x00 0x240000>;
			no-map;
			phandle = <0x83>;
		};

		wifi-dma@87500000 {
			compatible = "restricted-dma-pool";
			reg = <0x00 0x87500000 0x00 0x100000>;
			phandle = <0x84>;
		};

		gnss@87600000 {
			reg = <0x00 0x87600000 0x00 0x1fdc00>;
			no-map;
			phandle = <0x86>;
		};

		btwf-sync@877fdc00 {
			reg = <0x00 0x877fdc00 0x00 0x2000>;
			no-map;
			phandle = <0x82>;
		};

		gnss-sync@877ffc00 {
			reg = <0x00 0x877ffc00 0x00 0x400>;
			no-map;
			phandle = <0x87>;
		};

		smem@88000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x88000000 0x00 0x40000>;
			no-map;
			phandle = <0x46>;
		};

		pmsys@88040000 {
			reg = <0x00 0x88040000 0x00 0x2c0000>;
			no-map;
			phandle = <0x45>;
		};

		audiodsp@89000000 {
			reg = <0x00 0x89000000 0x00 0x600000>;
			no-map;
		};

		modem@89600000 {
			reg = <0x00 0x89600000 0x00 0x4900000>;
			no-map;
			phandle = <0x6c>;
		};

		smem@8e000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x8e000000 0x00 0x900000>;
			no-map;
			phandle = <0x6d>;
		};

		audio@94100000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x94100000 0x00 0x200000>;
			no-map;
			phandle = <0x15>;
		};

		audio@94380000 {
			reg = <0x00 0x94380000 0x00 0x80000>;
			no-map;
			phandle = <0x12>;
		};

		reserved@b0000000 {
			reg = <0x00 0xb0000000 0x00 0x6100000>;
			no-map;
		};

		framebuffer-region@9e000000 {
			compatible = "framebuffer";
			reg = <0x00 0x9e000000 0x00 0x465000>;
			iommu-addresses = <0x02 0x9e000000 0x465000>;
			no-map;
			phandle = <0x36>;
		};

		ramoops@fff80000 {
			compatible = "ramoops";
			reg = <0x00 0xfff80000 0x00 0x40000>;
			console-size = <0x8000>;
			record-size = <0x8000>;
			pmsg-size = <0x8000>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x00 0x8000000>;
			reusable;
			linux,cma-default;
		};
	};

	cpufreq {
		compatible = "sprd,cpufreq-v2";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		#performance-domain-cells = <0x01>;
		status = "okay";
		sprd,soc-version = <0x00 0x36303654>;
		phandle = <0x0e>;

		cluster@0 {
			reg = <0x00>;
			nvmem-cells = <0x03>;
			nvmem-cell-names = "dvfs_bin";
			sprd,pmic-type = <0x00>;
			sprd,transition-delay-us = <0x1f4>;
		};

		cluster@1 {
			reg = <0x01>;
			nvmem-cells = <0x04>;
			nvmem-cell-names = "dvfs_bin";
			sprd,pmic-type = <0x01>;
			sprd,transition-delay-us = <0x1f4>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x05>;
				};

				core1 {
					cpu = <0x06>;
				};

				core2 {
					cpu = <0x07>;
				};

				core3 {
					cpu = <0x08>;
				};

				core4 {
					cpu = <0x09>;
				};

				core5 {
					cpu = <0x0a>;
				};
			};

			cluster1 {

				core6 {
					cpu = <0x0b>;
				};

				core7 {
					cpu = <0x0c>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x07>;
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			performance-domains = <0x0e 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x00 0x600>;
			enable-method = "psci";
			cpu-idle-states = <0x0f>;
			performance-domains = <0x0e 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x00 0x700>;
			enable-method = "psci";
			cpu-idle-states = <0x0f>;
			performance-domains = <0x0e 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;
		};
	};

	idle-states {
		entry-method = "psci";

		cpu-pd-lit {
			compatible = "arm,idle-state";
			entry-latency-us = <0x3e8>;
			exit-latency-us = <0x1f4>;
			min-residency-us = <0x9c4>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0x0d>;
		};

		cpu-pd-big {
			compatible = "arm,idle-state";
			entry-latency-us = <0xfa0>;
			exit-latency-us = <0xfa0>;
			min-residency-us = <0x2710>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0x0f>;
		};
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04>;
		interrupt-affinity = <0x05 0x06 0x07 0x08 0x09 0x0a>;
	};

	pmu-a75 {
		compatible = "arm,cortex-a75-pmu";
		interrupts = <0x00 0x76 0x04 0x00 0x77 0x04>;
		interrupt-affinity = <0x0b 0x0c>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
		arm,no-tick-in-suspend;
	};

	audio-dsp {
		compatible = "sprd,ums9230-agdsp";
		sprd,syscon-aon-apb = <0x10>;
		mboxes = <0x11 0x05>;
		memory-region = <0x12>;
		resets = <0x13 0x0b 0x13 0x07>;
		reset-names = "core", "sys";
		#power-domain-cells = <0x00>;
		phandle = <0x16>;
	};

	audio-platform {
		compatible = "sprd,pcm-platform";
		dmas = <0x14 0x0c 0x14 0x09 0x14 0x0e>;
		dma-names = "voice_c", "fast_p", "dspcap_c";
		memory-region = <0x15>;
		phandle = <0x89>;
	};

	audio-routing {
		compatible = "sprd,ums9230-vbc";
		sprd,dsp = <0x16>;
		memory-region = <0x15>;
	};

	display-subsystem {
		compatible = "sprd,display-subsystem";
		ports = <0x17>;
		status = "okay";
	};

	soc {
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x80000000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		interrupt-controller@10000000 {
			compatible = "arm,gic-v3";
			reg = <0x10000000 0x20000 0x10040000 0x100000>;
			#interrupt-cells = <0x03>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			redistributor-stride = <0x00 0x20000>;
			#redistributor-regions = <0x01>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		syscon@20000000 {
			compatible = "sprd,ums9230-glbregs", "syscon", "simple-mfd";
			reg = <0x20000000 0x10000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x20000000 0x10000>;

			clock-controller@0 {
				compatible = "sprd,ums9230-apapb-gate";
				reg = <0x00 0x3000>;
				clocks = <0x18>;
				clock-names = "ext-26m";
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x1b>;
			};
		};

		clock-controller@20010000 {
			compatible = "sprd,ums9230-ap-clk";
			reg = <0x20010000 0x1000>;
			clocks = <0x18 0x19 0x1a>;
			clock-names = "ext-26m", "dphy-250m", "dphy-333m3";
			#clock-cells = <0x01>;
			phandle = <0x1c>;
		};

		serial@200a0000 {
			compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
			reg = <0x200a0000 0x100>;
			interrupts = <0x00 0x02 0x04>;
			clocks = <0x1b 0x0e 0x1c 0x01 0x18>;
			clock-names = "enable", "uart", "source";
			status = "okay";
		};

		serial@200b0000 {
			compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
			reg = <0x200b0000 0x100>;
			interrupts = <0x00 0x03 0x04>;
			clocks = <0x1b 0x0f 0x1c 0x02 0x18>;
			clock-names = "enable", "uart", "source";
			status = "okay";
		};

		serial@200c0000 {
			compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
			reg = <0x200c0000 0x100>;
			interrupts = <0x00 0x04 0x04>;
			clocks = <0x1b 0x10 0x1c 0x03 0x18>;
			clock-names = "enable", "uart", "source";
			status = "disabled";
		};

		i2c@200d0000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x200d0000 0x100>;
			interrupts = <0x00 0x0b 0x04>;
			clocks = <0x1c 0x04 0x18 0x1b 0x09>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			lens@c {
				compatible = "dongwoon,dw9800k";
				reg = <0x0c>;
				vdd-supply = <0x1d>;
				dongwoon,sac-mode = <0x02>;
				dongwoon,vcm-prescale = <0x75>;
				phandle = <0x26>;
			};

			camera@10 {
				compatible = "samsung,s5k3p3";
				reg = <0x10>;
				reset-gpios = <0x1e 0x2c 0x01>;
				clocks = <0x1f 0x0d>;
				clock-names = "mclk";
				assigned-clocks = <0x20 0x02>;
				assigned-clock-parents = <0x21 0x05>;
				assigned-clock-rates = <0x16e3600>;
				vio-supply = <0x22>;
				avdd-supply = <0x23>;
				dvdd-supply = <0x24>;
				rotation = <0x10e>;
				orientation = <0x00>;

				port {

					endpoint {
						data-lanes = <0x01 0x02 0x03 0x04>;
						remote-endpoint = <0x25>;
						phandle = <0x43>;
					};
				};
			};

			camera@36 {
				compatible = "ovti,ov64b40";
				reg = <0x36>;
				reset-gpios = <0x1e 0x2f 0x01>;
				clocks = <0x1f 0x0d>;
				clock-names = "xclk";
				assigned-clocks = <0x20 0x02>;
				assigned-clock-parents = <0x21 0x05>;
				assigned-clock-rates = <0x16e3600>;
				dovdd-supply = <0x22>;
				avdd-supply = <0x23>;
				dvdd-supply = <0x24>;
				lens-focus = <0x26>;
				rotation = <0x5a>;
				orientation = <0x01>;

				port {

					endpoint {
						data-lanes = <0x01 0x02 0x03 0x04>;
						remote-endpoint = <0x27>;
						phandle = <0x41>;
					};
				};
			};
		};

		i2c@200e0000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x200e0000 0x100>;
			interrupts = <0x00 0x0c 0x04>;
			clocks = <0x1c 0x05 0x18 0x1b 0x0a>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			camera@10 {
				compatible = "ovti,ov8856";
				reg = <0x10>;
				reset-gpios = <0x1e 0x29 0x01>;
				clocks = <0x1f 0x0c>;
				clock-names = "xvclk";
				clock-frequency = <0x124f800>;
				assigned-clocks = <0x20 0x03>;
				assigned-clock-parents = <0x21 0x04>;
				dovdd-supply = <0x22>;
				avdd-supply = <0x28>;
				dvdd-supply = <0x24>;
				rotation = <0x5a>;
				orientation = <0x01>;

				port {

					endpoint {
						link-frequencies = <0x00 0x2aea5400 0x00 0x15752a00>;
						data-lanes = <0x01 0x02>;
						remote-endpoint = <0x29>;
						phandle = <0x42>;
					};
				};
			};
		};

		i2c@200f0000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x200f0000 0x100>;
			interrupts = <0x00 0x0d 0x04>;
			clocks = <0x1c 0x06 0x18 0x1b 0x0b>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "disabled";
		};

		i2c@20100000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x20100000 0x100>;
			interrupts = <0x00 0x0e 0x04>;
			clocks = <0x1c 0x07 0x18 0x1b 0x0c>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			touchscreen@48 {
				compatible = "chipone,icnl9916";
				reg = <0x48>;
				interrupts-extended = <0x1e 0x90 0x02>;
				touchscreen-reset-gpios = <0x1e 0x91 0x01>;
				reset-gpios = <0x1e 0x32 0x01>;
			};
		};

		i2c@20110000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x20110000 0x100>;
			interrupts = <0x00 0x0f 0x04>;
			clocks = <0x1c 0x08 0x18 0x1b 0x0d>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "disabled";
		};

		i2c@20210000 {
			compatible = "sprd,ums9230-i2c", "sprd,sc9860-i2c";
			reg = <0x20210000 0x100>;
			interrupts = <0x00 0x23 0x04>;
			clocks = <0x1c 0x09 0x18 0x1b 0x1a>;
			clock-names = "i2c", "source", "enable";
			clock-frequency = <0x61a80>;
			status = "disabled";
		};

		i2c@20220000 {
