					pddelta-calib@2 {
						reg = <0x02 0x02>;
						bits = <0x07 0x07>;
						phandle = <0x55>;
					};

					fgu-calib@6 {
						reg = <0x06 0x02>;
						bits = <0x00 0x09>;
						phandle = <0x52>;
					};

					pdrc-calib@7 {
