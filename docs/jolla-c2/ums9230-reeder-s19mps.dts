					led@1 {
						label = "green";
						reg = <0x01>;
					};

					led@2 {
						label = "blue";
						reg = <0x02>;
					};
				};

				rtc@200 {
					compatible = "sprd,sc2730-rtc", "sprd,sc2731-rtc";
