		usb@64900000 {
			compatible = "sprd,ums9230-musb", "sprd,musb";
			reg = <0x64900000 0x2000>;
			interrupts = <0x00 0x45 0x04>;
			interrupt-names = "mc";
			clocks = <0x3d 0x18>;
			phys = <0x6a>;
			status = "okay";
			dr_mode = "otg";
			usb-role-switch;
			role-switch-default-mode = "peripheral";

			port {

				endpoint {
					remote-endpoint = <0x6b>;
					phandle = <0x59>;
				};
			};
		};

		hwspinlock@64910000 {
			compatible = "sprd,hwspinlock-r3p0";
			reg = <0x64910000 0x1000>;
			#hwlock-cells = <0x01>;
			clocks = <0x3d 0x19>;
			clock-names = "enable";
			phandle = <0x4d>;
		};

		modem@65003400 {
			compatible = "sprd,ums9230-modem";
			reg = <0x65003400 0x1000>;
			sprd,syscon-aon-apb = <0x10>;
			resets = <0x13 0x04>;
			power-domains = <0x31 0x0e>;
			memory-region = <0x6c>;
			firmware-name = "sprd/l_modem.bin";
			wakeup-source;

			sipc {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				label = "modem";
				mboxes = <0x11 0x02>;
				memory-region = <0x6d>;
				sprd,sipx-dl-blk-count = <0x200>;
				sprd,sipx-dl-ack-count = <0x40>;
				sprd,sipx-ul-blk-count = <0x200>;
				sprd,sipx-ul-ack-count = <0x00>;

				channel@2 {
					reg = <0x02>;
					sprd,channel-type = "sblock";
					sprd,channel-name = "imsbr_data";
					sprd,rx-blk-count = <0x40>;
					sprd,rx-blk-size = <0x640>;
					sprd,tx-blk-count = <0x40>;
					sprd,tx-blk-size = <0x640>;
				};

				channel@3 {
					reg = <0x03>;
					sprd,channel-type = "sblock";
					sprd,channel-name = "imsbr_ctrl";
					sprd,rx-blk-count = <0x40>;
					sprd,rx-blk-size = <0x640>;
					sprd,tx-blk-count = <0x40>;
					sprd,tx-blk-size = <0x640>;
				};

				channel@4 {
					reg = <0x04>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "lte_misc";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x14>;
					sprd,tx-buf-size = <0x1000>;
					sprd,rx-buf-size = <0x1000>;

					nv@1 {
						compatible = "sprd,spipe-nv";
						reg = <0x01 0x01>;
						sprd,channel-name = "lte_nv";
					};

					timesync@8 {
						compatible = "sprd,spipe-time";
						reg = <0x08 0x08>;
						sprd,channel-name = "lte_time";
					};
				};

				channel@6 {
					reg = <0x06>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "lte_at";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x20>;
					sprd,tx-buf-size = <0x800>;
					sprd,rx-buf-size = <0x800>;

					atcmd@0 {
						compatible = "sprd,spipe-at";
						reg = <0x00 0x00>;
						sprd,channel-name = "lte_at0";
					};

					atcmd@1 {
						compatible = "sprd,spipe-at";
						reg = <0x01 0x01>;
						sprd,channel-name = "lte_at1";
					};

					atcmd@2 {
						compatible = "sprd,spipe-at";
						reg = <0x02 0x02>;
						sprd,channel-name = "lte_at2";
					};

					atcmd@3 {
						compatible = "sprd,spipe-at";
						reg = <0x03 0x03>;
						sprd,channel-name = "lte_at3";
					};

					atcmd@4 {
						compatible = "sprd,spipe-at";
						reg = <0x04 0x04>;
						sprd,channel-name = "lte_at4";
					};

					atcmd@5 {
						compatible = "sprd,spipe-at";
						reg = <0x05 0x05>;
						sprd,channel-name = "lte_at5";
					};
				};

				channel@7 {
					compatible = "sprd,seth";
					reg = <0x07>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte0";
				};

				channel@8 {
					compatible = "sprd,seth";
					reg = <0x08>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte1";
				};

				channel@9 {
					compatible = "sprd,seth";
					reg = <0x09>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte2";
				};

				channel@18 {
					compatible = "sprd,seth";
					reg = <0x12>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte3";
				};

				channel@19 {
					compatible = "sprd,seth";
					reg = <0x13>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte4";
				};

				channel@20 {
					compatible = "sprd,seth";
					reg = <0x14>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte5";
				};

				channel@21 {
					reg = <0x15>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "lte_diag";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x01>;
					sprd,tx-buf-size = <0x8000>;
					sprd,rx-buf-size = <0x20000>;

					diag@0 {
						compatible = "sprd,spipe-diag";
						reg = <0x00 0x00>;
						sprd,channel-name = "lte_diag0";
					};
				};

				channel@24 {
					compatible = "sprd,seth";
					reg = <0x18>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte6";
				};

				channel@25 {
					compatible = "sprd,seth";
					reg = <0x19>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte7";
				};

				channel@26 {
					compatible = "sprd,seth";
					reg = <0x1a>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte8";
				};

				channel@27 {
					compatible = "sprd,seth";
					reg = <0x1b>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte9";
				};

				channel@28 {
					compatible = "sprd,seth";
					reg = <0x1c>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte10";
				};

				channel@29 {
					compatible = "sprd,seth";
					reg = <0x1d>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte11";
				};

				channel@30 {
					compatible = "sprd,seth";
					reg = <0x1e>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte12";
				};

				channel@31 {
					compatible = "sprd,seth";
					reg = <0x1f>;
					sprd,channel-type = "sipx";
					sprd,channel-name = "seth_lte13";
				};
			};
		};
	};

	thermal-zones {

		cputop0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x6e 0x00>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x6f>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x6f>;
					cooling-device = <0x05 0xffffffff 0xffffffff 0x06 0xffffffff 0xffffffff 0x07 0xffffffff 0xffffffff 0x08 0xffffffff 0xffffffff 0x09 0xffffffff 0xffffffff 0x0a 0xffffffff 0xffffffff>;
