	wcn {
		compatible = "sprd,ums9230-wcn";
		dma-ranges = <0x00 0x00 0x87000000 0x800000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		sprd,syscon-ap-pub-apb = <0x7a>;
		sprd,syscon-ap-aon-apb = <0x10>;
		sprd,syscon-wcn-aon-ahb = <0x7b>;
		sprd,syscon-wcn-aon-apb = <0x7c>;
		resets = <0x13 0x06>;
		power-domains = <0x31 0x18>;
		wakeup-source;
		enable-gpios = <0x1e 0x76 0x00>;
		reset-gpios = <0x1e 0x75 0x01>;
		vdd-supply = <0x7d>;
		vddwifipa-supply = <0x7e>;
		dcxo1v8-supply = <0x7f>;

		btwf {
			dma-ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			sprd,syscon-wcn-ahb = <0x80>;
			memory-region = <0x81>;
			sprd,sync-region = <0x82>;
			firmware-name = "sprd/wcnmodem.bin";

			sipc {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				label = "wcn";
				mboxes = <0x11 0x08>;
				memory-region = <0x83>;

				channel@4 {
					reg = <0x04>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "wcn_misc";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x10>;
					sprd,tx-buf-size = <0x2400>;
					sprd,rx-buf-size = <0x2400>;

					atcmd@5 {
						reg = <0x05 0x05>;
						sprd,channel-name = "wcn_atcmd";
					};

					bluetooth@10 {
						compatible = "sprd,bluetooth-sipc";
						reg = <0x0a 0x0b>;
						sprd,channel-name = "wcn_bt";
						local-bd-address = [00 00 00 00 00 00];
					};

					fm@13 {
						reg = <0x0d 0x0e>;
						sprd,channel-name = "wcn_fm";
					};
				};

				channel@5 {
					reg = <0x05>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "wcn_log";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x01>;
					sprd,tx-buf-size = <0x00>;
					sprd,rx-buf-size = <0x1000>;

					log@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "wcn_log0";
					};
				};

				channel@7 {
					compatible = "sprd,umw2631-wlan", "sprd,sc2355-wlan";
					reg = <0x07>;
					sprd,channel-type = "sblock";
					sprd,channel-name = "wcn_wifi_cmd";
					sprd,tx-blk-count = <0x04>;
					sprd,tx-blk-size = <0x800>;
					sprd,rx-blk-count = <0x08>;
					sprd,rx-blk-size = <0x800>;
					memory-region = <0x84>;
					local-mac-address = [00 00 00 00 00 00];
				};

				channel@8 {
					reg = <0x08>;
					sprd,channel-type = "sblock";
					sprd,channel-name = "wcn_wifi_data0";
					sprd,tx-blk-count = <0x200>;
					sprd,tx-blk-size = <0x200>;
					sprd,rx-blk-count = <0x200>;
					sprd,rx-blk-size = <0x400>;
				};

				channel@9 {
					reg = <0x09>;
					sprd,channel-type = "sblock";
					sprd,channel-name = "wcn_wifi_data1";
					sprd,tx-blk-count = <0x08>;
					sprd,tx-blk-size = <0x680>;
					sprd,rx-blk-count = <0x40>;
					sprd,rx-blk-size = <0x680>;
				};

				channel@11 {
					reg = <0x0b>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "wcn_loopcheck";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x01>;
					sprd,tx-buf-size = <0x400>;
					sprd,rx-buf-size = <0x400>;

					loopcheck@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "wcn_loopcheck0";
					};
				};

				channel@12 {
					reg = <0x0c>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "wcn_assert";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					sprd,num-buffers = <0x01>;
					sprd,tx-buf-size = <0x400>;
					sprd,rx-buf-size = <0x400>;

					assert@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "wcn_assert0";
					};
				};
			};
		};

		gnss {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			sprd,syscon-wcn-ahb = <0x85>;
			memory-region = <0x86>;
			sprd,sync-region = <0x87>;
			firmware-name = "sprd/gnssmodem.bin";
			phandle = <0x47>;
		};
	};

	clk-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "ext-26m";
		phandle = <0x18>;
	};

	clk-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "ext-32k";
		phandle = <0x48>;
	};

	clk-100m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "rco-100m";
		phandle = <0x49>;
	};

	dphy-250m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xee6b280>;
		clock-output-names = "dphy-250m";
		phandle = <0x19>;
	};

	dphy-333m3 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x13ddc120>;
		clock-output-names = "dphy-333m3";
		phandle = <0x1a>;
	};

	aliases {
		serial0 = "/soc/serial@200a0000";
		serial1 = "/soc/serial@200b0000";
		mmc0 = "/soc/mmc@201a0000";
		i2c0 = "/soc/i2c@200d0000";
		i2c1 = "/soc/i2c@200e0000";
		i2c2 = "/soc/i2c@200f0000";
		i2c3 = "/soc/i2c@20100000";
		i2c4 = "/soc/i2c@20110000";
		i2c5 = "/soc/i2c@20210000";
		i2c6 = "/soc/i2c@20220000";
		i2c7 = "/soc/i2c@641a0000";
	};

	chosen {
		stdout-path = "serial1:115200n8";

		framebuffer {
			compatible = "simple-framebuffer";
			memory-region = <0x36>;
			width = <0x2d0>;
			height = <0x640>;
			stride = <0xb40>;
			format = "a8r8g8b8";
			status = "disabled";
		};
	};

	backlight {
		compatible = "pwm-backlight";
		pwms = <0x88 0x02 0x9c40>;
		brightness-levels = <0x00 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15 0x17 0x19 0x1b 0x1d 0x1f 0x21 0x23 0x25 0x27 0x29 0x2b 0x2d 0x2f 0x31 0x33 0x35 0x37 0x39 0x3b 0x3d 0x3f 0x41 0x43 0x45 0x47 0x49 0x4b 0x4d 0x4f 0x51 0x53 0x55 0x57 0x59 0x5b 0x5d 0x5f 0x61 0x63 0x65 0x67 0x69 0x6b 0x6d 0x6f 0x71 0x73 0x75 0x77 0x79 0x7b 0x7d 0x7f 0x81 0x83 0x85 0x87 0x89 0x8b 0x8d 0x8f 0x92 0x95 0x98 0x9b 0x9e 0xa1 0xa4 0xa7 0xaa 0xad 0xb0 0xb3 0xb6 0xb9 0xbc 0xbf 0xc2 0xc5 0xc8 0xcb 0xce 0xd1 0xd4 0xd7 0xda 0xdd 0xe0 0xe3 0xe6 0xe9 0xed 0xf1 0xf5 0xf8 0xfc 0x100 0x104 0x108 0x10c 0x110 0x114 0x118 0x11c 0x120 0x124 0x128 0x12c 0x130 0x134 0x138 0x13c 0x140 0x144 0x148 0x14c 0x150 0x156 0x15a 0x15e 0x163 0x168 0x16d 0x172 0x177 0x17c 0x181 0x186 0x18b 0x190 0x196 0x19c 0x1a2 0x1a8 0x1ae 0x1b4 0x1ba 0x1c0 0x1c6 0x1cc 0x1d2 0x1d8 0x1de 0x1e4 0x1ea 0x1f0 0x1f6 0x1fc 0x202 0x207 0x20c 0x212 0x218 0x21e 0x224 0x22a 0x230 0x236 0x23c 0x242 0x248 0x24e 0x254 0x25a 0x260 0x266 0x26c 0x272 0x278 0x27e 0x284 0x28a 0x290 0x296 0x29e 0x2a4 0x2aa 0x2b0 0x2b6 0x2bc 0x2c2 0x2c8 0x2ce 0x2d4 0x2da 0x2e0 0x2e6 0x2ec 0x2f2 0x2f8 0x2fe 0x304 0x30a 0x310 0x316 0x31c 0x322 0x328 0x32e 0x334 0x33a 0x340 0x346 0x34c 0x352 0x358 0x35e 0x364 0x36a 0x370 0x376 0x37c 0x382 0x388 0x38e 0x394 0x39a 0x3a0 0x3a6 0x3ac 0x3b1 0x3b6 0x3bb 0x3c0 0x3c5 0x3ca 0x3cf 0x3d4 0x3d9 0x3de 0x3e3 0x3e8 0x3ee 0x3f4 0x3fa 0x3ff>;
		default-brightness-level = <0x64>;
		phandle = <0x3a>;
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x3e8000>;
		charge-term-current-microamp = <0x1fbd0>;
		constant-charge-voltage-max-microvolt = <0x432380>;
		constant-charge-current-max-microamp = <0x1e8480>;
		voltage-min-design-microvolt = <0x3567e0>;
		voltage-max-design-microvolt = <0x42ae50>;
		factory-internal-resistance-micro-ohms = <0x416e0>;
		resistance-temp-table = <0x2d 0x35 0x19 0x64 0x0a 0x18b 0x00 0x237 0xfffffff6 0x319>;
		ocv-capacity-celsius = <0x14>;
		ocv-capacity-table-0 = <0x428f10 0x64 0x41db60 0x5f 0x40f100 0x5a 0x400a88 0x55 0x3f33b0 0x50 0x3e64a8 0x4b 0x3da540 0x46 0x3cbec8 0x41 0x3c2288 0x3c 0x3b5b50 0x37 0x3acac8 0x32 0x3a6150 0x2d 0x3a0f48 0x28 0x39cce0 0x23 0x399e00 0x1e 0x397ad8 0x19 0x393c58 0x14 0x38d6c8 0x0f 0x3859c8 0x0a 0x381378 0x05 0x33e140 0x00>;
		phandle = <0x4b>;
	};

	flash-controller {
		compatible = "sgmicro,sgm3140";
		flash-gpios = <0x1e 0x8b 0x00>;
		enable-gpios = <0x1e 0x20 0x00>;

		led {
			function = "flash";
			color = <0x00>;
			flash-max-timeout-us = <0x3d090>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			wakeup-source;
			debounce-interval = <0x02>;
			gpios = <0x50 0x01 0x01>;
			linux,code = <0x74>;
		};

		key-volumeup {
			wakeup-source;
			debounce-interval = <0x02>;
			gpios = <0x1e 0x7c 0x01>;
			linux,code = <0x73>;
		};

		key-volumedown {
			wakeup-source;
			debounce-interval = <0x02>;
			gpios = <0x50 0x04 0x00>;
			linux,code = <0x72>;
		};
	};

	modem-dai {
		compatible = "sprd,ums9230-modem-dai", "option,gtm601";
		#sound-dai-cells = <0x00>;
		sound-name-prefix = "Modem DAI";
		phandle = <0x8a>;
	};

	sound {
		compatible = "sprd,ums9230-audio-card";
		model = "reeder-s19mps";
		sprd,pcm-platform = <0x89>;
		memory-region = <0x15>;
		widgets = "Headphone", "Headphones", "Speaker", "Speaker", "Line", "Modem Uplink", "Line", "Modem Downlink";
		pin-switches = "Speaker";
		audio-routing = "Headphones", "HPL_OUT", "Headphones", "HPR_OUT", "Speaker Amp INL", "HPL_OUT", "Speaker Amp INR", "HPL_OUT", "Speaker", "Speaker Amp OUTL", "Speaker", "Speaker Amp OUTR", "Modem Uplink", "Modem DAI AOUT", "Modem DAI AIN", "Modem Downlink";
		aux-devs = <0x8a 0x8b>;

		iis0-dai-link {
			link-name = "IIS0";
			dai-format = "i2s";
			frame-inversion;
			sprd,fixed-fmt = <0x18>;

			codec {
				sound-dai = <0x8c 0x00 0x8d 0x00>;
			};
		};

		iis1-dai-link {
			link-name = "IIS1";
			dai-format = "i2s";
			frame-inversion;
			sprd,fixed-fmt = <0x18>;

			codec {
				sound-dai = <0x8c 0x01 0x8d 0x01>;
			};
		};

		voice-dai-link {
			link-name = "VOICE";

			codec {
				sound-dai = <0x8a>;
			};
		};
	};

	speaker-amp {
		compatible = "simple-audio-amplifier";
		sound-name-prefix = "Speaker Amp";
		enable-gpios = <0x1e 0x88 0x00>;
		phandle = <0x8b>;
	};
};
