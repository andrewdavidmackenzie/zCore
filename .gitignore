# Personal/local config (not shared)
.claude/settings.local.json

# Cargo build output (includes rootfs, images, and kernel binaries)
**/target

# Build cache: downloaded toolchains, compiled busybox, etc.
# Survives `cargo clean` (which only removes target/).
**/.build-cache

# Legacy locations (safe to remove from checkouts that predate #79)
*.img
/ignored
/rootfs
/zCore/disk

# Generated target spec JSON files (built by xtask from targets/*.toml)
targets/*.json

.DS_Store
__pycache__

.idea/
.jiri_root/
tools/.build-cache/
